          "description": "What kind of entity to search for. Default: master (the canonical album, independent of pressing). Use 'release' to find a specific pressing, 'artist' or 'label' for those entities.",
          "enum": [
            "release",
            "master",
            "artist",
            "label",
          ],
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "search_discogs",
    "properties": [
      "per_page",
      "query",
      "type",
    ],
    "required": [
      "query",
    ],
  },
