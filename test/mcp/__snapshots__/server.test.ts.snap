[
  {
    "arguments": [],
    "description": "Browse and explore your Discogs music collection",
    "name": "browse_collection",
  },
  {
    "arguments": [],
    "description": "Get insights and statistics about your music collection",
    "name": "collection_insights",
  },
  {
    "arguments": [
      {
        "description": undefined,
